    <string name="app_name">LockedIn</string>
    <string name="accessibility_service_label">LockedIn detection service</string>
    <string name="accessibility_service_description">
        Detects and immediately blocks YouTube Shorts and Instagram Reels screens.
        Screen content is evaluated on-device only and never transmitted or stored anywhere.
    </string>
    <string name="overlay_message">Short-form content blocked</string>
